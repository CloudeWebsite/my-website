# ─── Core ────────────────────────────────────────────────────────────────
# Public URL of the site (no trailing slash). Used for emails, OG images, sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL (Supabase / Neon / local). Supabase: use the pooled URL here
# and the direct URL in DIRECT_URL for migrations.
DATABASE_URL="postgresql://studio:studio@localhost:5432/studio?schema=public"
DIRECT_URL="postgresql://studio:studio@localhost:5432/studio?schema=public"

# ─── Auth.js (NextAuth v5) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Set to true when running behind a proxy other than Vercel
AUTH_TRUST_HOST="true"

# Seed admin (used by prisma/seed.ts only)
SEED_ADMIN_EMAIL="admin@studio.local"
SEED_ADMIN_PASSWORD="ChangeMe-2026!"

# ─── Email (Resend) ─────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty in development: emails are printed to the console.
RESEND_API_KEY=""
EMAIL_FROM="Studio <studio@yourdomain.com>"
# Where new-enquiry notifications go
STUDIO_NOTIFY_EMAIL="hello@yourdomain.com"

# ─── Rate limiting (Upstash Redis) ──────────────────────────────────────
# Leave empty in development: an in-memory limiter is used instead.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── File storage ───────────────────────────────────────────────────────
# "local" writes to ./public/uploads (public images) and ./storage (private
# enquiry attachments). Vercel's filesystem is read-only, so use "supabase"
# in production.
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLIC_BUCKET="media"
SUPABASE_PRIVATE_BUCKET="enquiries"

# Extra hostnames allowed in next/image (comma separated)
NEXT_PUBLIC_IMAGE_HOSTS=""

# ─── Hero ───────────────────────────────────────────────────────────────
# Leave at 0 to use the real-time 3D house. Set to the frame count produced
# by `npm run frames -- hero.mp4` to scrub a pre-rendered image sequence instead.
NEXT_PUBLIC_HERO_FRAMES="0"
# The /render route (used by `npm run render:stills`) is disabled in production
# builds unless this is "1".
ALLOW_RENDER_ROUTE="0"
